# ===================================================================
# CampusConnectAI Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit real secrets or credentials to version control.
# ===================================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Single-server origin (in this unified Vite+Express setup, requests are same-origin)
CLIENT_URL=http://localhost:3000

# -------------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------------
# MongoDB connection URI (e.g., mongodb+srv://<user>:<password>@cluster0.mongodb.net/campusconnect)
# If unconfigured in development, the app runs in demo mode using in-memory mock data.
# For production persistence, providing MONGODB_URI is required.
MONGODB_URI=

# -------------------------------------------------------------------
# Admin Authentication (REQUIRED IN PRODUCTION)
# -------------------------------------------------------------------
# Administrator email address for portal management
ADMIN_EMAIL=admin@campusconnect.edu

# Bcrypt hash of your admin password (generate with: npx bcrypt-cli hash "YourSecurePassword")
# In production mode (NODE_ENV=production), ADMIN_PASSWORD_HASH is mandatory.
ADMIN_PASSWORD_HASH=

# Cryptographically strong secret key used for signing and verifying JWT tokens
# Generate with: openssl rand -base64 32
# In production mode, JWT_SECRET is mandatory.
JWT_SECRET=

# -------------------------------------------------------------------
# Google Gemini API
# -------------------------------------------------------------------
# Google AI Studio / Gemini API Key
# If omitted, Campus AI automatically falls back to curated college FAQ matching.
GEMINI_API_KEY=

# Model identifier (recommended: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Model call timeout in milliseconds
GEMINI_TIMEOUT_MS=15000

# Maximum retry attempts on transient model errors
GEMINI_MAX_RETRIES=1
